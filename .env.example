# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Microsoft SQL Server (Mu Online Season 6 Database)
DB_HOST="127.0.0.1"
DB_PORT="1433"
DB_USER="sa"
DB_PASS="YourStrongMSSQLPassword123!"
DB_NAME="MuOnline"
DB_ENCRYPT="false"
DB_TRUST_SERVER_CERT="true"
DB_ALLOW_MOCK="false"

# Ajuste se o seu emulador usar nomes de tabelas/colunas diferentes.
DB_ACCOUNT_TABLE="MEMB_INFO"
DB_CHARACTER_TABLE="Character"
DB_GUILD_TABLE="Guild"
DB_GUILD_MEMBER_TABLE="GuildMember"
DB_ONLINE_TABLE="MEMB_STAT"
DB_ONLINE_STATUS_COLUMN="ConnectStat"
DB_ONLINE_STATUS_VALUE="1"
DB_GUILD_MEMBER_CHARACTER_COLUMN="Name"
DB_GUILD_MEMBER_GUILD_COLUMN="G_Name"
DB_MASTER_LEVEL_COLUMN="MasterResetCount"
DB_GRAND_RESET_COLUMN="MasterResetCount"
DB_SIEGE_TABLE="MuCastle_DATA"
DB_SIEGE_OWNER_COLUMN="OWNER_GUILD"

# Metadados exibidos; números e rankings vêm do SQL Server.
SERVER_NAME="MU ONLINE SEASON 6"
SERVER_SUBTITLE="Classic Hard & Dynamic Engine"
SERVER_VERSION="Season 6 Episode 3"
SERVER_EXPERIENCE="20x ~ 5x (Dinâmica)"
SERVER_DROP_RATE="20%"
SERVER_MAX_ONLINE="1500"
SERVER_MASTER_EXPERIENCE="5x"
SERVER_MAX_LEVEL="400"
SERVER_MAX_RESET="100 Resets"
SERVER_RESET_POINTS="Acumulativo (300 pts)"
SERVER_BUG_BLESS="Offline (Desativado)"
SERVER_MONSTER_SPAWN="5 a 8 monstros"
SERVER_PARTY_EXPERIENCE="Configurada no servidor"
SERVER_GAMEPLAY_SUMMARY="Classic Hard com progressão competitiva, PvP equilibrado e economia controlada."
SERVER_CONNECT_STATUS="Online"
SERVER_GAME1_STATUS="Online"
SERVER_GAME2_STATUS="Online"

# Mercado Pago Integration (Pix Payments)
MERCADOPAGO_ACCESS_TOKEN="TEST-0000000000000000-000000-00000000000000000000000000000000-000000000"
MERCADOPAGO_WEBHOOK_SECRET="your_webhook_secret_key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"


